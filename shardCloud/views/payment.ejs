<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        .payment-content {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
        }

        .prototype-notice {
            background: white;
            padding: 40px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            max-width: 600px;
        }

        .prototype-notice h1 {
            color: #ff6b35;
            font-size: 3rem;
            margin-bottom: 20px;
        }

        .prototype-text {
            font-size: 1.5rem;
            color: #28a745;
            margin-bottom: 30px;
            font-weight: bold;
        }

        .selected-provider {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 15px;
            margin: 20px 0;
            text-align: left;
        }

        .provider-summary h3 {
            color: #667eea;
            margin-bottom: 10px;
        }

        .cost-breakdown {
            background: #e3f2fd;
            padding: 15px;
            border-radius: 10px;
            margin: 15px 0;
        }

        .cost-item {
            display: flex;
            justify-content: space-between;
            margin: 8px 0;
        }

        .total-cost {
            font-weight: bold;
            font-size: 1.2em;
            border-top: 2px solid #667eea;
            padding-top: 10px;
            color: #667eea;
        }

        .prototype-benefits {
            text-align: left;
            margin: 30px 0;
        }

        .prototype-benefits h3 {
            text-align: center;
            color: #333;
            margin-bottom: 15px;
        }

        .prototype-benefits ul {
            max-width: 300px;
            margin: 0 auto;
        }

        .prototype-benefits li {
            margin: 10px 0;
            font-size: 16px;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
            text-align: center;
        }

        .btn-success {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            padding: 18px 36px;
            font-size: 18px;
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background: #5a6268;
        }

        @media (max-width: 768px) {
            .prototype-notice h1 {
                font-size: 2rem;
            }
            
            .action-buttons {
                flex-direction: column;
                align-items: center;
            }
            
            .btn-success {
                width: 100%;
                max-width: 300px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="payment-content">
            <div class="prototype-notice">
                <h1>🚧 This is a Prototype</h1>
                <p class="prototype-text">This is a demonstration version for FREE</p>
                
                <div class="selected-provider">
                    <h2>Selected Storage Provider</h2>
                    <div class="provider-summary">
                        <h3><%= provider.name %></h3>
                        <p><strong>Available Space:</strong> <%= provider.space %>GB</p>
                        <p><strong>Price per GB:</strong> $<%= provider.price %></p>
                        <p><strong>Description:</strong> <%= provider.description %></p>
                    </div>
                    
                    <div class="cost-breakdown">
                        <h4>Cost Breakdown:</h4>
                        <div class="cost-item">
                            <span>Storage Space:</span>
                            <span><%= provider.space %>GB</span>
                        </div>
                        <div class="cost-item">
                            <span>Price per GB:</span>
                            <span>$<%= provider.price %></span>
                        </div>
                        <div class="cost-item total-cost">
                            <span>Total Cost:</span>
                            <span>$<%= (provider.space * provider.price).toFixed(2) %></span>
                        </div>
                        <div class="cost-item" style="color: #28a745;">
                            <span>Prototype Discount:</span>
                            <span>-$<%= (provider.space * provider.price).toFixed(2) %></span>
                        </div>
                        <div class="cost-item total-cost" style="color: #28a745;">
                            <span>You Pay:</span>
                            <span>FREE</span>
                        </div>
                    </div>
                </div>
                
                <div class="prototype-benefits">
                    <h3>🎉 Free Prototype Benefits:</h3>
                    <ul>
                        <li>✅ Upload and store your files securely</li>
                        <li>✅ Experience the full platform</li>
                        <li>✅ No payment or credit card required</li>
                        <li>✅ Test all features including download</li>
                        <li>✅ Files stored on local server</li>
                    </ul>
                </div>
                
                <div class="action-buttons">
                    <a href="/upload/<%= provider.id %>" class="btn btn-success">
                        📁 Start Uploading Files
                    </a>
                    <a href="/marketplace" class="btn btn-secondary">
                        ← Back to Marketplace
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
