<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        body{
            font-family:monospace;
            font-size: 19px;
            overflow: hidden;
        }
        footer{
            height:70px;
            width:99vw;
            background-color: #3a4380;
            z-index: 10;
            display:flex;
            justify-content: space-evenly;
            align-items: center;
        }
        button{
            height:45px;
            border-radius: 5px;
            font-size: 15px;
            font-family:monospace;
            background-color: transparent;
            border: 2px solid rgba(0, 0, 0, 0.155);
        }
        .container{
            display:flex;
            height:90vh;
            justify-content: end;
            width:99vw;
        }
        video{
            margin:10px;
            border-radius: 5px;
            position:relative;
            border:10px double #3a4380;
            aspect-ratio: 16/9;
            object-fit: cover;
            width:70%;
        }
        .grid{
            display:flex;
            justify-content: space-evenly;
            align-items: center;
            flex-wrap: wrap;
            width:100%;
            overflow:auto;
            height:100%;
            background-color: white;
            box-shadow: 20px 20px 100px  rgba(0, 0, 0, 0.321) inset;
        }
        .grid > div{
            border:2px solid red;
            /* height:fit-content; */
            padding:0;
            object-fit: contain;
        }
        .grid::-webkit-scrollbar{
            display:none;
        }
        .chat_box{
            height: 70%;
            width:95%;
            overflow: scroll;
            padding:10px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            font-family: monospace;
            font-size: 15px;
            /* background-color: rgb(218, 247, 166 ); */
            background-color: white;
            color: #160c0b;
        }
        .chat_box::-webkit-scrollbar{
            display: none;
        }
        input[type=text]{
            width:80%;
            border-radius: 50px;
            background-color: rgba(0, 0, 0, 0.112);
            height: 40px;
            display:flex;
            flex-direction: column;
            border:none;
            outline:none;
            padding-left:10px;
            /* box-shadow: 0px 0px 5px rgb(8, 143, 143); */
        }
        .holder{
            width:30%;
            display: flex;
            flex-direction: column;
            height:100%;
            overflow: hidden;
            display:none;
            background-color: #3a4380;
            color:white;
            min-width: 250px;
        }
        .chat_holder{
            display:flex;
            justify-content: space-evenly;
            align-items: center;
        }
        .chat_cross{
            width:90%;
            text-align: center;
            font-family: monospace;
        }
        .close{
            background-color: transparent;
            border:none;
            width:30px;
            height:30px;
            color:white;
            font-size: 20px;
            border-radius: 50%;
            font-weight: bolder;
        }
        .close:hover{
            background-color: rgba(255, 255, 255, 0.244);
        }
         .section_2 > button:hover{
            background-color: #3a4380;
            color:white;
            box-shadow: 0px 0px 5px rgb(218, 247, 166 );
        }
        .section_3 > button:hover{
            background-color: #3a4380;
            color:white;
            box-shadow: 0px 0px 5px rgb(218, 247, 166 );
        }
        .section_2{
            width:400px;
        }
        .section_1, .section_2, .section_3{
            display: flex;
            justify-content: space-evenly;
            border-radius: 5px;
            align-items: center;
            background-color : rgba(255, 255, 255, 0.248);
            height:55px;
            
            border: 2px solid rgba(0, 0, 0, 0.307);
            /* filter: blur(1px); */
        }
        .section_1, .section_3{
            width:15%;
        }
        .section_3{
            text-align: end;
        }
        .text{
            display:flex;
            justify-content: space-evenly;
            width:100%;
            background-color: white;
            height:9%;
            align-items: center;
        }
        #send:hover{
            background-color: rgba(0, 0, 0, 0.158);
        }
        #send{
            border-radius: 50%;
        }
        svg path{
            stroke:#6874c0;
            fill:transparent;
            stroke-dasharray: 60px;
            stroke-dashoffset: 60px;
            animation:send 2s ease-out infinite;
        }
        #profile{
            min-width:30px;
            min-height:30px;
            background-color: #3a4380;
            border-radius: 10%;
            display:inline-block;
            display:flex;
            justify-content: center;
            align-items: center;
            margin-right: 10px;
            color: white;
        }
        #profile_holder{
            display:flex;
            align-items: center;
        }
        .flex{
            display:flex;
            justify-content: space-between;
            align-items:center;
            width:100%;
            height:auto;
            margin-bottom: 10px;
            padding-right: 10px;
        }
        #chatter{
            background-color: #160c0b;
            color:white;
            max-height:30px;
        }
        .participants{
            position:absolute;
            height:60vh;
            width:35vw;
            background-color: white;
            border-radius: 5px;
            top:20vh;
            left:32.5vw;
            display:none;
            box-shadow: 0px 0px 50px rgba(0, 0, 0, 0.321);
            overflow-y: auto;
            overflow-x: hidden;
            /* min-width: 350px; */
        }
        .participants .title button{
            height:30px;
            width:30px;
            border-radius: 50%;
        }
        .title div{
            text-align: center;
            width:90%;
            font-family: monospace;
        }
        .title {
            display:flex;
            justify-content: center;
            align-items: center;
            width:100%;
            height:10%;
            font-weight: bolder;
        }
        .list{
            width:97%;
            height:89%;
            padding-left:10px;
        }
        .closePart:hover{
            color:#3a4380;
        }
        .closePart{
            font-size: 20px;
            border:none;
            font-weight: bolder;
        }
        .to{
            font-size: 15px;
            margin-left: 5px;
        }
        .showUp{
            height:20px;
            width:100px;
            font-size: 13px;
            background-color: #160c0b;
            color:white;
            margin-left: 5px;
        }
        .emojis{
            width:200px;
            background-color:#160c0b;
            border-radius: 5px;
            position: absolute;
            z-index: 100;
            height:50px;
            display:flex;
            justify-content: space-evenly;
            align-items: center;
            left:calc((100vw - 200px)/2);
            top:82vh;
            display: none;
        }
        #fit{
            position: absolute;
            left:calc((100vw - 50px)/2);
            width:50px;
            height:50px;
            font-size: 40px;
            border-radius: 5px;
            top:480px;
            animation: move 2s ease-in-out 1;
            animation-fill-mode: forwards;
            border:none;
        }
        .emojis button{
            background-color: transparent;
            border:none;
            width:40px;
            height:40px;
            border-radius: 5px;
            font-size: 25px;
        }
        .emojis button:hover{
            background-color: rgba(255, 255, 255, 0.256);
        }
        .notify{
            position:absolute;
            width:fit-content;
            height:fit-content;
            top:10px;
            background-color: white;
            box-shadow: 0px 0px 50px rgba(0, 0, 0, 0.321);
            display: none;
            text-align: center;
            font-size: 15px;
        }
        .more{
            display:none;
        }
        @keyframes move {
            0%{
                opacity: 0;
            }
            50%{
                opacity: 1;
            }
            100%{
                transform: translateY(-150px);
                opacity: 0;
            }
        }
        @keyframes send {
            80%{
                fill:transparent;
            }
            100%{
                stroke-dashoffset: 0;
                fill:#6874c0
            }
        }
        @media only screen and (max-width:740px){
            .section_1, .security, .section_3{
                display:none;
            }
            .participants{
                width:80vw;
                height:60vh;
                left:10vw;
                top:20vh;
            }
            #profile{
            width:20px;
            height:20px;
            font-size: 12px;
        }
        .title{
            font-size: 15px;
        }        
        #chatter{
            font-size: 10px;
        }
        .more{
            display:block;
        }
        .video{
            width:90%;
        }

        }
    </style>
    <script  src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
    <script  src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.2/socket.io.js" integrity="sha512-VJ6+sp2E5rFQk05caiXXzQd1wBABpjEj1r5kMiLmGAAgwPItw1YpqsCCBtq8Yr1x6C49/mTpRdXtq8O2RcZhlQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script  src="/socket.io/socket.io.js"></script>
    </head>
<body>
    <header>
        <div class="notify"></div>
    </header>
    <div class="container">
        <div class="grid">
        </div>
        <div class="holder">
            <div class ="chat_holder">
                <button class="showUp">Everyone</button>
                <div class="chat_cross">Chat...</div>
                <button class="close" onclick="closeChat()">x</button></div>
            <div class="chat_box">
            </div>
            <div class="text">
            <input type="text" placeholder="type in your message">
            <svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve" style="enable-background:new 0 0 24 24" viewBox="0 0 24 24" id="send" height="30" width="30">
                <g id="Layer_2">
                  <g>
                    <path d="M17.1108,3.084l-1.3086,0.3091C15.5903,3.4312,15.394,3.4844,15.187,3.542l-0.084,0.0234
