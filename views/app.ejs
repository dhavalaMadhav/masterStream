                          c0.0119,0.0132,0.0159,0.0304,0.0286,0.0432c0.0128,0.0128,0.0302,0.0169,0.0435,0.0289
                          c0.0937,0.1057,0.1656,0.2316,0.1987,0.3764l0.7803,3.4209C10.7241,19.9561,12.0381,21,13.5791,21
                          c1.2119,0,2.2817-0.646,2.8599-1.7241c1.876-3.4663,3.2744-7.1787,4.1543-11.0288l0.3203-1.3604
                          c0.0005-0.0015,0.001-0.0029,0.0015-0.0044c0.2466-1.0708-0.0703-2.1743-0.8477-2.9521
                          C19.2896,3.1523,18.1846,2.834,17.1108,3.084z M18.9663,6.4316l-0.3208,1.3633c-0.8418,3.6797-2.1758,7.2222-3.9673,10.5322
                          C14.3643,18.9126,13.855,19,13.5791,19c-0.5083,0-1.0908-0.3037-1.2451-0.9824l-0.7808-3.4219
                          c-0.0435-0.1906-0.1259-0.3613-0.2036-0.5341l2.3564-2.356c0.3906-0.3901,0.3906-1.0234,0-1.4141s-1.0234-0.3906-1.4141,0
                          l-2.3568,2.3564c-0.1744-0.0785-0.3471-0.1611-0.5397-0.205L5.9868,11.665c-0.7983-0.1875-0.9468-0.8696-0.9736-1.0742
                          c-0.0259-0.2021-0.0566-0.8916,0.6621-1.2744c3.0938-1.6821,6.4248-2.9629,9.9272-3.8145l0.1187-0.0327
                          c0.1465-0.0405,0.2852-0.0806,0.4873-0.1187l1.356-0.3188C17.6558,5.0107,17.7466,5,17.8359,5
                          c0.3042,0,0.5923,0.1196,0.8169,0.3442C18.9438,5.6353,19.0581,6.0317,18.9663,6.4316z"></path>
                  </g>
                </g>
              </svg>
            </div>
            <div class="to">To: <span>Everyone</span></div>
        </div>
    </div>
    <footer>
        <div class="section_1">
                <button class="mute">mute</button>
                <button class="video">start video</button>
        </div>
        <div class="section_2">
            <button class="btnPart" onclick="openPart()">participants</button>
            <button class="chat" onclick="openChat()">Chat</button>
            <button class="reactions" onclick="openReactions()">reactions</button>
            <button class="security">security</button>
            <button class="more">more</button>
        </div>
        <div class="section_3">
            <button class="endSession">End</button>
        </div>
    </footer>
    <div class="participants">
        <div class="title">
            <div>Participants</div>
            <button onclick="closePart()" class="closePart">x</button>
        </div>
        <div class="list">
        </div>
    </div>
    <div class="emojis">
        <button id="done">👍🏼</button>
        <button id="heart">❤️</button>
        <button id="laugh">🤣</button>
        <button id="ok">🫡</button>
    </div>
    <script>
        peers={};
        const socket= io();
        const ROOM_ID = "<%= roomId %>"
        var c=0;
        var peer= new Peer(undefined, {
            host:'masterstream.onrender.com',
            path: '/peerjs',
            secure: true
        });
        footer = document.querySelector("footer");
        // document.addEventListener('mousemove', ()=>{
        //     footer.style.top="90.3vh"
        //     footer.style.display="flex";
        //     document.addEventListener("click", ()=>{
        //     footer.style.top="100vh"
        //         footer.style.display="none";
        // })
        // })

        const holder= document.querySelector(".holder");
        const participants = document.querySelector(".participants");
        const list = document.querySelector(".list");
        to= document.querySelector("span");
        showUp= document.querySelector(".showUp");
        reactions=document.querySelector('.reaction');
        reactions_all = document.querySelector(".emojis");
        buttons=document.querySelectorAll(".emojis button");
        Object_of_reaction={
            heart: "❤️",
            laugh: "🤣",
            ok: "🫡",
            done: "👍🏼"
        }
        to.innerText="Everyone";
        openChat=()=>{
            holder.style.display="flex"
        }
        closeChat=()=>{
            holder.style.display="none";
        }
        openPart=()=>{
            participants.style.display="inline-block";
            username="Everyone";
            document.querySelectorAll('#chatter').forEach((btn)=>{
            btn.addEventListener("click", (el)=>{
            to.innerText= btn.previousElementSibling.innerText.substring(2);
            holder.style.display="flex";
            showUp.innerText="Private";
            })
        })
        // console.log(document.querySelectorAll('#chatter'));
        }
        closePart=()=>{
            participants.style.display="none";
        }

        openReactions=()=>{
            reactions_all.style.display= "flex";
        }

        buttons.forEach(ele=>{
            ele.addEventListener('click', ()=>{
                socket.emit('emoji', ele.id);
            })
        })
        socket.on('add_emoji', eleId=>{
            fit = document.createElement("div");
                    document.body.append(fit);
                    fit.id="fit"
                    fit.append(Object_of_reaction[eleId]);
                    reactions_all.style.display= "none";
        })


        showUp.addEventListener('click', ()=>{
            if(to.innerText!="Everyone"){
                showUp.style.backgroundColor="#160c0b";
                showUp.style.color="white";
                to.innerText="Everyone";
                showUp.innerText="Everyone"
            }
        })
        endSession= document.querySelector(".endSession");
        endSession.addEventListener('click', ()=>{
            window.location="/";
        })
        console.log(document.querySelectorAll('#chatter'));
        chat_box=document.querySelector(".chat_box");
        send=document.querySelector("#send");
        send.addEventListener('click', (ele)=>{
            message= document.querySelector("input").value;  
            if(to.innerText=="Everyone"){
            if(message!=""){
            socket.emit("message", message, peer.id); // socket.send(message); also works
            };
            document.querySelector("input").value="";
        }
        else{
            if(message!=""){
            socket.emit("message_pvt", message, peer.id, to.innerText); // socket.send(message); also works
            }
            document.querySelector("input").value="";
        }
        })
         socket.on('send_msg', (data, peerID)=>{
            chat_box.innerHTML+=`<div class="flex"><div id="profile_holder"> <div id="profile">${peerID.substring(0, 2)}</div> ${data}</div><div>`;
         })
         socket.on('private', (data, peer_id)=>{
            chat_box.innerHTML+=`<div class="flex"><div id="profile_holder"> <div id="profile">${peer_id.substring(0, 2)}</div> ${data}</div></div>`;
         })
         socket.on("listOfPart", arrayOfParticipants=>{
            list.innerHTML="";
            arrayOfParticipants.forEach(id=>{
            list.innerHTML+=`<div class="flex"><div id="profile_holder"> <div id="profile">${id.substring(0, 2)}</div> ${id}</div> <button id="chatter">Chat</button></div>`;
            console.log("listed participants");
            })
         })
        const myVideo= document.createElement("video");
        let video_grid= document.querySelector(".grid");
        let Start_stop_video= document.querySelector(".video");
        Start_stop_video.addEventListener("click", ()=>{
            navigator.mediaDevices.getUserMedia({
            video:false,
            audio:true
        }).then(stream=>{
            stream.getTracks().forEach(track => track.stop());
            video_grid.srcObject = null;
        })
        })
         video_append = async ()=>{
            stream =  await navigator.mediaDevices.getUserMedia({
            video:true,
            audio:true
        })
            appendVideo(myVideo, stream);
            peer.on('call', call=>{
                call.answer(stream);
                const videoelement = document.createElement("video");
                call.on('stream', streamVideo=>{
                    appendVideo(videoelement, streamVideo);
                })
            })
            socket.on('user-connected', userId=>{
                console.log(`user connected ${userId}`);

                //notifying
                document.querySelector(".notify").innerText=`✅${userId} joined the room`;
                document.querySelector(".notify").style.display="block";
                setTimeout(()=>{
                    document.querySelector(".notify").style.display="none";
                }, 3000);
                setTimeout(()=>{
                const call= peer.call(userId, stream);
                peers[userId]=call;
                // console.log(peers);
                const videoELEMENT= document.createElement("video");
                call.on("stream", streamVideo=>{
                    appendVideo(videoELEMENT, streamVideo);
                })
                call.on('close', ()=>{
                    videoELEMENT.remove();
                })
                }, 1000);
            })
         }
         video_append();
        
        socket.on('user-disconnected', id=>{
            document.querySelector(".notify").innerText=`❌${id} left the room`;
                document.querySelector(".notify").style.display="block";
                setTimeout(()=>{
                    document.querySelector(".notify").style.display="none";
                }, 3000);
            if(peers[id]){
                peers[id].close();
            }
            socket.emit("delete", id);
        })
        socket.on("delete_part", peerId=>{
            console.log("deleting id");
            document.querySelectorAll(".flex").forEach((div)=>{
                console.log(div.innerText);
                if(div.innerText==peerId){
                    div.remove();
                }
            })
        })
        peer.on("open", id=>{
            socket.emit("join-room", ROOM_ID, id);
            socket.emit("participants", id);
        })
        function appendVideo(video, streamVideo){
            console.log("count");
            video.srcObject=streamVideo;
            video.addEventListener('loadedmetadata', ()=>{
                video.play();
            })
            if(video){
            div= document.createElement("div");
            video_grid.append(video);
            }
            c=0;
            document.querySelectorAll("video").forEach((element)=>{
                c++;
                if(c==2){
                    document.querySelectorAll("video").forEach(ele=>{
                    ele.style.width=`${eval(video_grid.clientWidth / 2 -100)}px`;
                })
                }
            else if(c>2){
                document.querySelectorAll("video").forEach(ele=>{
            ele.style.width=`${eval(video_grid.clientWidth / 3 -100)}px`;
            ele.style.height=`${eval(video_grid.clientHeight / 2 )}px`;
                })
            }
            })
        }
    </script>
</body>
</html>