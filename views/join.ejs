<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        body{
            overflow: hidden;
        }
        .id{
            width:500px;
            height:40px;
            padding-left: 10px;
            border-top-left-radius: 5px;
            border-bottom-left-radius: 5px;
            border:none;
            outline:none;
            background-color: white;
        }
        input[type="text"]{
            width:500px;
            height:40px;
            padding-left: 10px;
            border:none;
            outline:none;
            background-color: white;
        }
        .join_class{
            height:43px;
            background-color: #160c0b;
            border-top-right-radius: 5px;
            border-bottom-right-radius: 5px;
            border:none;
            color:white;
            font-family: monospace;
        }
        .join_class:hover{
            box-shadow: 0px 0px 10px white;
        }
        .header{
            background-color: #3a4380;
            display: flex;
            width:99vw;
            align-items: center;
            justify-content: center;
            height: 10vh;
        }
        .body{
            display:flex;
            justify-content: center;
            align-items: center;
            width:99vw;
            height:89vh;
            background-color: #160c0b;
        }
        svg path{
            stroke:#3a4380;
            stroke-dasharray: 300px;
            stroke-dashoffset: 300px;
            animation:send 5s ease-out infinite;
        }
        @keyframes send {
            25%{
                fill:transparent;
            }
            50%{
                fill:transparent;
            }
            60%{
                stroke-dashoffset: 0;
            }
            100%{
                stroke-dashoffset: 0;
                stroke-width: 0;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <input type="text" placeholder="enter the room Id" class="id">
        <button class="join_class">Join Room</button>
    </div>
