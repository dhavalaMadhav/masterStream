                </g>
              </svg>
            </div>
            <div class="to">To: <span>Everyone</span></div>
            <div class="center"><button class="res_part">Participants</button></div>
        </div>
    </div>
    <script>
        peers={};
        const socket= io();
        const ROOM_ID = "<%= roomId %>"
        var c=0;
         var peer= new Peer(undefined, {
            host:'/',
            path: '/peerjs',
            secure: true
        });
        const part_button=document.querySelector(".res_part");
        const close_part=document.querySelector(".closePart");
        const holder= document.querySelector(".holder");
        const participants = document.querySelector(".participants");
        const grid_part=document.querySelector(".grid");
        const list = document.querySelector(".list");
        to= document.querySelector("span");
        showUp= document.querySelector(".showUp");
        to.innerText="Everyone";
            username="Everyone";
            document.querySelectorAll('#chatter').forEach((btn)=>{
            btn.addEventListener("click", ()=>{
            to.innerText= btn.previousElementSibling.innerText.substring(2);
            holder.style.display="flex";
            showUp.innerText="Private";
            })
        })
        showUp.addEventListener('click', ()=>{
            if(to.innerText!="Everyone"){
                showUp.style.backgroundColor="#160c0b";
                showUp.style.color="white";
                to.innerText="Everyone";
                showUp.innerText="Everyone"
            }
        })
        participants.style.display="block";
        part_button.addEventListener('click', ()=>{
            participants.style.display="block";
            grid_part.style.display="block";
            close_part.style.display="block";
        })
        closePart=()=>{
            participants.style.display="none";
        }
       window.addEventListener('resize', ()=>{
        var x = window.matchMedia("(max-width: 740px)")
        if(x.matches){
            close_part.style.display="block";
            participants.display="block"
        }else{
            grid_part.style.display="inline-block";
            participants.style.display="inline-block";
            close_part.style.display="none";
        }
       })
        endSession= document.querySelector(".endSession");
        // endSession.addEventListener('click', ()=>{
        //     window.location="/";
        // })
        chat_box=document.querySelector(".chat_box");
        send=document.querySelector("#send");
        send.addEventListener('click', (ele)=>{
            message= document.querySelector("input").value;  
            if(to.innerText=="Everyone"){
            if(message!=""){
            socket.emit("message", message, peer.id); // socket.send(message); also works
            };
            document.querySelector("input").value="";
        }
        else{
            if(message!=""){
            socket.emit("message_pvt", message, peer.id, to.innerText); // socket.send(message); also works
            }
            document.querySelector("input").value="";
        }
        })
         socket.on('send_msg', (data, peerID)=>{
            chat_box.innerHTML+=`<div class="flex"><div id="profile_holder"> <div id="profile">${peerID.substring(0, 2)}</div> ${data}</div><div>`;
         })
         socket.on('private', (data, peer_id)=>{
            chat_box.innerHTML+=`<div class="flex"><div id="profile_holder"> <div id="profile">${peer_id.substring(0, 2)}</div> ${data}</div></div>`;
         })
         socket.on("listOfPart", arrayOfParticipants=>{
            list.innerHTML="";
            arrayOfParticipants.forEach(id=>{
            list.innerHTML+=`<div class="flex"><div id="profile_holder"> <div id="profile">${id.substring(0, 2)}</div> ${id}</div> <button id="chatter">Chat</button></div>`;
            console.log("listed participants");
            })
         })
      
        peer.on("open", id=>{
            socket.emit("join-room", ROOM_ID, id);
            socket.emit("participants", id);
        })
       
    </script>
</body>
</html>