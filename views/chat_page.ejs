<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        body{
            font-family:monospace;
            font-size: 19px;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height:98vh;
            /* background-color: #160c0b; */
        }
        button{
            height:45px;
            border-radius: 5px;
            font-size: 15px;
            font-family:monospace;
            background-color: transparent;
            border: 2px solid rgba(0, 0, 0, 0.155);
        }
        .container{
            display:flex;
            width:90%;
            border-radius: 15px;
            box-shadow: 0px 0px 50px rgba(0, 0, 0, 0.255);
            height:90vh;
        }
        .chat_box{
            height: 70%;
            width:100%;
            overflow: scroll;
            padding:10px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            font-family: monospace;
            font-size: 15px;
            /* background-color: rgb(218, 247, 166 ); */
            background-color: white;
            color: #160c0b;
        }
        .chat_box::-webkit-scrollbar{
            display: none;
        }
        input[type=text]{
            width:80%;
            border-radius: 50px;
            background-color: rgba(0, 0, 0, 0.112);
            height: 75%;
            display:flex;
            flex-direction: column;
            border:none;
            outline:none;
            padding-left:10px;
            /* box-shadow: 0px 0px 5px rgb(8, 143, 143); */
        }
        .holder{
            width:70%;
            display: flex;
            flex-direction: column;
            height:100%;
            overflow: hidden;
            background-color: #3a4380;
            color:white;
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
        }
        .chat_holder{
            display:flex;
            justify-content: space-evenly;
            align-items: center;
        }
        .chat_cross{
            width:90%;
            height:30px;
            font-family: monospace;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .close{
            background-color: transparent;
            border:none;
            width:30px;
            height:30px;
        }
        .close:hover{
            box-shadow: rgb(218, 247, 166 );
        }
        button:hover{
            background-color: #454f91;
            color:white;
            box-shadow: 0px 0px 5px rgb(218, 247, 166 );
        }
       
        .text{
            display:flex;
            justify-content: space-evenly;
            width:100%;
            background-color: white;
            height:9%;
            align-items: center;
        }
        #send:hover{
            background-color: rgba(0, 0, 0, 0.158);
        }
        #send{
            border-radius: 50%;
        }
        svg path{
            stroke:#6874c0;
            fill:transparent;
            stroke-dasharray: 60px;
            stroke-dashoffset: 60px;
            animation:send 2s ease-out infinite;
        }
        #profile{
            min-width: 20px;
            min-height: 20px;
            width:30px;
            height:30px;
            background-color: #3a4380;
            border-radius: 10%;
            display:inline-block;
            display:flex;
            justify-content: center;
            align-items: center;
            margin-right: 10px;
            color: white;
        }
        #profile_holder{
            display:flex;
            align-items: center;
            font-size: 16px;
        }
        .grid{
            border-top-left-radius: 10px;
            border-bottom-left-radius: 10px;
            background-color: white;
        }
        .flex{
            display:flex;
            justify-content: space-between;
            align-items: center;
            width:90%;
            height:auto;
            margin-bottom: 10px;
        }
        #chatter{
            background-color: #160c0b;
            color:white;
            height:fit-content;
            width:fit-content;
            font-size: 15px;
        }
        .participants{
            width:30vw;
            background-color: white;
            border-top-left-radius: 10px;
            border-bottom-left-radius: 10px;
            padding-top: 10px;
        }
        /* .participants .title button{
            height:30px;
            width:30px;
            border-radius: 50%;
        } */
        .title div{
            text-align: center;
            width:90%;
            font-family: monospace;
        }
        .title {
            display:flex;
            justify-content: space-evenly;
            align-items: center;
            width:100%;
            height:10%;
            font-weight: bolder;
        }
        .list{
            width:100%;
            height:90%;
            padding:10px;
        }
        .closePart:hover{
            background-color: rgba(0, 0, 0, 0.156);
        }
        .closePart{
            display:none;
            border-radius: 50%;
            min-height:30px;
            min-width:30px;
            border:none;
        }        
        .closePart:hover{
            color:#3a4380;
        }
        .to{
            font-size: 15px;
            margin-left: 5px;
        }
        .showUp{
            height:20px;
            width:100px;
            font-size: 13px;
            background-color: #160c0b;
            color:white;
            margin-left: 5px;
        }
        .emojis{
            width:200px;
            background-color: white;
            border-radius: 5px;
            position: absolute;
            z-index: 100;
            height:50px;
            display:flex;
            justify-content: space-evenly;
            align-items: center;
            left:calc((100vw - 200px)/2);
            top:82vh;
            display: none;
        }
        #fit{
            position: absolute;
            left:calc((100vw - 50px)/2);
            width:50px;
            height:50px;
            font-size: 40px;
            border-radius: 5px;
            top:480px;
            animation: move 2s ease-in-out 1;
            animation-fill-mode: forwards;
            border:none;
        }
        .emojis button{
            background-color: transparent;
            border:none;
            width:40px;
            height:40px;
            border-radius: 5px;
            font-size: 25px;
        }
        .emojis button:hover{
            background-color: rgba(0, 0, 0, 0.19);
        }
        .res_part{
            width:fit-content;
            height:30px;
            background-color: transparent;
            color:white;
        }
        .res_part:hover{
            background-color: #3a4380;
            box-shadow: 0px 0px 5px rgb(218, 247, 166 );
        }
        .center{
            width:100%;
            text-align: center;
            display:none;
        }
        @keyframes move {
            0%{
                opacity: 0;
            }
            50%{
                opacity: 1;
            }
            100%{
                transform: translateY(-150px);
                opacity: 0;
            }
        }
        @keyframes send {
            80%{
                fill:transparent;
            }
            100%{
                stroke-dashoffset: 0;
                fill:#6874c0
            }
        }
        @media only screen and (max-width: 740px) {
            .grid{
                display:none;
            }
            .holder{
                border-radius: 15px;
                width:100%;
            }
            .center{
                display: inline-block;
            }
            .participants{
            position:absolute;
            height:40%;
            width:50%;
            background-color: white;
            border-radius: 5px;
            top:20%;
            left:25%;
            box-shadow: 0px 0px 50px rgba(0, 0, 0, 0.321);
            overflow-y: auto;
            overflow-x: hidden;
        }
        #profile_holder{
            font-size: 10px;
        }
        #chatter{
            font-size: 10px;
        }
        #profile{
            width:20px;
            height:20px;
            font-size: 12px;
        }
        .title{
            font-size: 15px;
        }
    }
    </style>
    <script  src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
    <script  src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.2/socket.io.js" integrity="sha512-VJ6+sp2E5rFQk05caiXXzQd1wBABpjEj1r5kMiLmGAAgwPItw1YpqsCCBtq8Yr1x6C49/mTpRdXtq8O2RcZhlQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script  src="/socket.io/socket.io.js"></script>
    </head>
<body>
    <header></header>
    <div class="container">
        <div class="grid">
            <div class="participants">
        <div class="title">
            <div>Participants</div>
            <button onclick="closePart()" class="closePart">x</button>
        </div>
        <div class="list">

        </div>
    </div>
        </div>
        <div class="holder">
            <div class ="chat_holder">
                <button class="showUp">Everyone</button>
                <div class="chat_cross">Chat...</div></div>
            <div class="chat_box">
            </div>
            <div class="text">
            <input type="text" placeholder="type in your message">
